# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env)
# ==============================================================================

# Core Django Settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://127.0.0.1,http://localhost

# Database Configuration (PostgreSQL / SQLite)
# For Neon / Supabase / Vercel Postgres / Railway:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Or standard SQLite (default for local development):
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Optional Separate PostgreSQL parameters:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=sms_db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
